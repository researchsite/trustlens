# TrustLens — Environment Variables
# Copy this file to .env.local and fill in your values
# Never commit .env.local to git

# ── LLM (Nebius AI — Qwen3-30B) ──────────────────────────────────────────────
NEBIUS_API_KEY=your_nebius_api_key_here
NEBIUS_BASE_URL=https://api.studio.nebius.ai/v1/
NEBIUS_MODEL=Qwen/Qwen3-30B-A3B

# ── Web Search (Tavily) ───────────────────────────────────────────────────────
TAVILY_API_KEY=your_tavily_api_key_here

# ── Vision / Product Identification (Novita AI) ───────────────────────────────
NOVITA_API_KEY=your_novita_api_key_here
NOVITA_BASE_URL=https://api.novita.ai/v3/openai
NOVITA_VISION_MODEL=llava-13b

# ── SMS (Twilio) ──────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_FROM_NUMBER=+1XXXXXXXXXX

# ── ZooData — e-commerce intelligence API (api.zoodata.ai) ───────────────────
# Key format: hms_xxx  — get from ZooData rep
ZOODATA_API_KEY=hms_your_key_here

# ── ZooWork — LLM proxy (clawapi.ecap.gsmo.ai) ───────────────────────────────
# Key format: zwp_live_xxx — 40+ models including Claude, GPT, Gemini, DeepSeek
ZOOWORK_API_KEY=zwp_live_your_key_here
ZOOWORK_BASE_URL=https://clawapi.ecap.gsmo.ai/service/v1

# ── Web Content Extraction (TinyFish) — optional, upgrades scoring ───────────
TINYFISH_API_KEY=your_tinyfish_api_key_here
